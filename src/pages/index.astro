      +'<div style="font-size:10px;color:#8b7355;letter-spacing:0.14em;text-transform:uppercase;margin-top:4px;font-weight:700;">Digital POS & Kwitansi Komisi</div>'
      +'<div style="display:inline-block;margin-top:8px;padding:3px 12px;background:#f5efe4;border-radius:999px;font-size:11px;color:#8b7355;font-weight:600;">📅 '+today+'</div>'
      +'</div>'
      /* Customer Box */
      +'<div style="margin-bottom:16px;padding:14px 16px;background:#faf6ed;border-radius:12px;border:1.5px solid #e5dccb;">'
      +'<div style="font-size:10px;color:#8b7355;text-transform:uppercase;letter-spacing:0.1em;font-weight:800;margin-bottom:6px;">👤 Customer Info</div>'
      +'<div style="font-size:16px;font-weight:800;color:#2a1f0e;">'+cName+'</div>'
      +'<div style="font-size:12px;color:#8b7355;margin-top:2px;">WhatsApp: '+cWa+'</div>'
      +'<div style="margin-top:10px;display:flex;gap:6px;align-items:center;flex-wrap:wrap;">'
