  /* ── PREVIEW / DOWNLOAD ────────────────────────── */
  function showPreview(){
    if(!validateCustomer(true)) return;
    var modal=el('r-modal'); var render=el('r-render'); if(!modal||!render) return;
    render.innerHTML=buildReceiptHTML();
    modal.classList.remove('hidden');
  }

  function downloadReceipt(){
    if(!validateCustomer(true)) return;
    var render=el('r-render'); if(!render) return;
    render.innerHTML=buildReceiptHTML();
    var card=render.firstElementChild; if(!card) return;
    if(typeof html2canvas==='undefined'){
      showToast('Gagal Memuat', 'html2canvas belum termuat', '⚠️');
      return;
    }
    showToast('Memproses Nota', 'Foto nota sedang disiapkan...', '📸');
    html2canvas(card,{scale:2,backgroundColor:'#fcfbf8',logging:false,useCORS:true}).then(function(canvas){
      var link=document.createElement('a');
      link.download='nota-amai-'+Date.now()+'.png';
      link.href=canvas.toDataURL('image/png');
      link.click();
      showToast('Foto Nota Disimpan!', 'Transaksi tetap tersimpan (hapus manual bila perlu)', '✅');
    }).catch(function(err){
      console.error(err);
      showToast('Gagal Mengunduh', 'Gagal memproses gambar nota', '❌');
    });
  }

  /* ── RESET ─────────────────────────────────────── */
  function resetAll(){
    if(!confirm('Reset seluruh data transaksi kasir?')) return;
    state.cart=[];
    state.status='belum';
    state.discType='persen';
    state.discVal=0;
    state.activeCat='all';
    state.search='';

    ['c-name','c-wa','q-search'].forEach(function(id){
      var e=el(id);
      if(e){
        e.value='';
        e.classList.remove('input-error');
      }
    });
    var dv=el('disc-val'); if(dv) dv.value='0';
    var rp=el('r-persen'); if(rp) rp.checked=true;
    var du=el('disc-unit'); if(du) du.textContent='%';

    var su=el('s-unpaid'); if(su) su.classList.add('s-active');
    var sp=el('s-paid');   if(sp) sp.classList.remove('s-paid-active');
    var pill=el('status-pill');
    if(pill){
      pill.textContent='Belum Bayar';
      pill.className='status-pill unpaid';
    }

    document.querySelectorAll('.cat-btn').forEach(function(b){ b.classList.remove('active'); });
    var allBtn=document.querySelector('.cat-btn[data-cat="all"]');
    if(allBtn) allBtn.classList.add('active');

    renderProducts();
    renderCart();
    updateTotals();
    showToast('Kasir Direset', 'Semua transaksi kembali kosong', '🔄');
  }

  /* ── SHORTCUTS MODAL ───────────────────────────── */
  function toggleShortcuts(show){
    var sm=el('shortcuts-modal');
    if(!sm) return;
    if(show===undefined) sm.classList.toggle('hidden');
    else if(show) sm.classList.remove('hidden');
    else sm.classList.add('hidden');
  }

  /* ── INIT ──────────────────────────────────────── */
  document.addEventListener('DOMContentLoaded',function(){
    renderDate();
    renderProducts();
    renderCart();
    updateTotals();
    updateDiscPillClasses();

    /* Currency Buttons */
    var bIdr = el('curr-btn-idr');
    var bUsd = el('curr-btn-usd');
    if(bIdr) bIdr.addEventListener('click', function(){ switchCurrency('IDR'); });
    if(bUsd) bUsd.addEventListener('click', function(){ switchCurrency('USD'); });

    /* Customer Inputs clear error on input */
    var cn = el('c-name'); if(cn) cn.addEventListener('input', function(){ cn.classList.remove('input-error'); });
    var cw = el('c-wa');   if(cw) cw.addEventListener('input', function(){ cw.classList.remove('input-error'); });

    /* Search Input */
    var qs=el('q-search');
    if(qs){
      qs.addEventListener('input',function(){
        state.search=qs.value.trim();
        renderProducts();
      });
    }

    /* Category Buttons */
    document.querySelectorAll('.cat-btn').forEach(function(btn){
      btn.addEventListener('click',function(){
        document.querySelectorAll('.cat-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        state.activeCat=btn.dataset.cat;
        renderProducts();
      });
    });

    /* Manual Accordion Toggle */
    var mt=el('manual-toggle');
    var mb=el('manual-body');
    var mi=el('manual-icon');
    if(mt&&mb){
      mt.addEventListener('click',function(){
        mb.classList.toggle('hidden');
        var open=!mb.classList.contains('hidden');
        if(mi) mi.textContent=open?'⊖':'⊕';
        if(open){ var mn=el('m-name'); if(mn) mn.focus(); }
      });
    }

    /* Manual Add */
    var madd=el('m-add');
    if(madd){
      madd.addEventListener('click',function(){
        var ne=el('m-name');
        var pe=el('m-price');
        var name=ne.value.trim();
        var price=parseInt(pe.value);
        if(!name){ ne.focus(); showToast('Nama Item Kosong', 'Tuliskan nama item terlebih dahulu', '⚠️'); return; }
        if(!price||price<0){ pe.focus(); showToast('Nominal Kosong', 'Tuliskan nominal harga item', '⚠️'); return; }
        state.cart.push({uid:uid(),id:'manual-'+uid(),name:name,price:price,qty:1,approx:false,isCustomPrice:true});
        showToast('Item Manual Ditambah', name + ' • ' + fmt(price), '📝');
        ne.value='';
        pe.value='';
        renderCart();
        updateTotals();
      });
    }
    var mp=el('m-price');
    if(mp){
      mp.addEventListener('keydown',function(e){
        if(e.key==='Enter'&&madd) madd.click();
      });
    }

    /* Status Buttons */
    var su=el('s-unpaid');
    var sp=el('s-paid');
    if(su){
      su.addEventListener('click',function(){
        state.status='belum';
        su.classList.add('s-active');
        sp.classList.remove('s-paid-active');
        var pill=el('status-pill');
        if(pill){ pill.textContent='Belum Bayar'; pill.className='status-pill unpaid'; }
      });
    }
    if(sp){
      sp.addEventListener('click',function(){
        state.status='lunas';
        sp.classList.add('s-paid-active');
        su.classList.remove('s-active');
        var pill=el('status-pill');
        if(pill){ pill.textContent='Sudah Lunas ✓'; pill.className='status-pill paid'; }
      });
    }

    /* Discount Inputs */
    var rp2=el('r-persen');
    var rn=el('r-nominal');
    var du2=el('disc-unit');
    if(rp2){
      rp2.addEventListener('change',function(){
        state.discType='persen';
        if(du2) du2.textContent='%';
        updateDiscPillClasses();
        updateTotals();
      });
    }
    if(rn){
      rn.addEventListener('change',function(){
        state.discType='nominal';
        if(du2) du2.textContent=currSymbol();
        updateDiscPillClasses();
        updateTotals();
      });
    }
    var dv2=el('disc-val');
    if(dv2){
      dv2.addEventListener('input',function(){
        state.discVal=parseFloat(dv2.value)||0;
        updateTotals();
      });
    }

    /* WhatsApp Button */
    var bw=el('btn-wa'); if(bw) bw.addEventListener('click',sendWhatsApp);
    var rw=el('r-wa');   if(rw) rw.addEventListener('click',sendWhatsApp);

    /* Preview & Download Modal */
    var bp=el('btn-preview');   if(bp) bp.addEventListener('click',showPreview);
    var bd=el('btn-download');  if(bd) bd.addEventListener('click',downloadReceipt);
    var rc=el('r-close');       if(rc) rc.addEventListener('click',function(){ el('r-modal').classList.add('hidden'); });
    var rb=el('r-backdrop');    if(rb) rb.addEventListener('click',function(){ el('r-modal').classList.add('hidden'); });
    var rdl=el('r-dl');         if(rdl) rdl.addEventListener('click',downloadReceipt);

    /* Toast Close */
    var tc=el('toast-close');
    if(tc) tc.addEventListener('click', function(){
      var toast=el('floating-toast');
      if(toast) toast.classList.remove('show');
    });

    /* ── GLOBAL KEYBOARD SHORTCUTS ───────────────── */
    window.addEventListener('keydown',function(e){
      var isInput = ['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName);

      /* Esc: close any modal, toast, or blur search */
      if(e.key==='Escape'){
        var toast=el('floating-toast');
        if(toast&&toast.classList.contains('show')){ toast.classList.remove('show'); }
        var rm=el('r-modal');
        if(rm&&!rm.classList.contains('hidden')){ rm.classList.add('hidden'); return; }
        if(isInput) document.activeElement.blur();
        return;
      }

      /* Alt + P: Preview */
      if(e.altKey && (e.key==='p'||e.key==='P')){
        e.preventDefault();
        showPreview();
        return;
      }

      /* Alt + D or Ctrl + Enter: Download */
      if((e.altKey && (e.key==='d'||e.key==='D')) || (e.ctrlKey && e.key==='Enter')){
        e.preventDefault();
        downloadReceipt();
        return;
      }

      /* When not in an input field */
      if(!isInput){
        /* / key: Focus search */
        if(e.key==='/'){
          e.preventDefault();
          var s=el('q-search');
          if(s){ s.focus(); s.select(); }
          return;
        }

        /* ? key: Toggle shortcuts helper */
        if(e.key==='?'){
          e.preventDefault();
          toggleShortcuts();
          return;
        }
      }
    });

  });

})();
</script>

