---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Amai Nota — Kwitansi Komisi Digital"
  description="Aplikasi kwitansi digital untuk komisi Amai Nota. Buat nota cantik dengan mudah."
>

<div class="app-root">

  <!-- ══ HEADER ══════════════════════════════════ -->
  <header class="site-header">
    <div class="header-brand">
      <span class="brand-icon">🌸</span>
      <span class="brand-name">Amai Nota</span>
    </div>

    <!-- Currency / Location Switcher (Moved to Far Right) -->
    <div class="curr-switcher" id="curr-switcher" title="Ubah Lokasi / Mata Uang Nota">
      <button type="button" class="curr-btn active" data-curr="IDR" id="curr-btn-idr">
        <span class="curr-flag">🇮🇩</span>
        <span class="curr-text">IDR (Rp)</span>
      </button>
      <button type="button" class="curr-btn" data-curr="USD" id="curr-btn-usd">
        <span class="curr-flag">🌍</span>
        <span class="curr-text">USD ($)</span>
      </button>
    </div>
  </header>

  <!-- ══ MAIN GRID ════════════════════════════════ -->
  <div class="main-grid">

    <!-- ── LEFT: CATALOG ──────────────────────── -->
    <section class="catalog-panel">

      <!-- Search Bar Card -->
      <div class="catalog-card search-card">
        <div class="search-wrap">
          <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input type="text" id="q-search" class="q-input"
            placeholder="Cari paket komisi... (tekan / untuk cari)"
            autocomplete="off" />
          <span class="kbd-pill" title="Tekan / untuk fokus cari">/</span>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="cat-bar" id="cat-bar">
        <button class="cat-btn active" data-cat="all">Semua Paket</button>
        <button class="cat-btn" data-cat="ilustrasi">Paket Ilustrasi</button>
        <button class="cat-btn" data-cat="charsheet">Character Sheet</button>
        <button class="cat-btn" data-cat="addon">Add-on & Printilan</button>
      </div>

      <!-- Manual Item Accordion Card -->
      <div class="manual-card">
        <button class="manual-head" id="manual-toggle" type="button">
          <div class="manual-head-left">
            <span class="manual-icon" id="manual-icon">⊕</span>
            <span class="manual-title">+ TAMBAH ITEM MANUAL / OPSI LAINNYA</span>
          </div>
          <span class="manual-chevron">▾</span>
        </button>
        <div class="manual-body hidden" id="manual-body">
          <input type="text" id="m-name" class="m-input"
            placeholder="Tulis nama item lainnya (wajib ditulis jelas)..."
            autocomplete="off" />
          <div class="manual-row2">
            <div class="manual-price-wrap">
              <span class="m-currency" id="m-currency">Rp</span>
              <input type="number" id="m-price" class="m-input m-price"
                placeholder="Harga nominal..." min="0" />
            </div>
            <button class="m-add-btn" id="m-add">+ Tambah</button>
          </div>
        </div>
      </div>

      <!-- Product Grid -->
      <div class="product-grid" id="product-grid"></div>

    </section>

    <!-- ── RIGHT: INVOICE PANEL ───────────────── -->
    <aside class="invoice-panel">

      <!-- Header Card -->
      <div class="inv-card inv-header-card">
        <div class="inv-head">
          <div>
            <h1 class="inv-title">RINCIAN TAGIHAN KOMISI</h1>
            <p class="inv-sub">Layanan Komisi Amai Nota</p>
          </div>
          <div class="inv-date-badge" id="inv-date">—</div>
        </div>
      </div>

      <!-- Status Transaksi Card -->
      <div class="inv-card status-card">
        <div class="status-bar">
          <div class="status-bar-left">
            <span class="status-circle">◎</span>
            <span>STATUS TRANSAKSI</span>
          </div>
          <div class="status-pill unpaid" id="status-pill">Belum Bayar</div>
        </div>
        <div class="status-btns">
          <button class="s-btn s-active" id="s-unpaid" type="button">
            <span>⏳</span> Belum Bayar
          </button>
          <button class="s-btn" id="s-paid" type="button">
            <span>✅</span> Sudah Lunas
          </button>
        </div>
      </div>

      <!-- Customer Card -->
      <div class="inv-card cust-card">
        <div class="cust-row">
          <div class="field">
            <label class="field-label" for="c-name">
              Nama Customer <span class="req-star" title="Wajib diisi">*</span>
            </label>
            <input type="text" id="c-name" class="field-input"
              placeholder="cth: Kak Sakura (wajib)" autocomplete="off" required />
          </div>
          <div class="field">
            <label class="field-label" for="c-wa">
              No. WhatsApp / Kontak <span class="req-star" title="Wajib diisi">*</span>
            </label>
            <input type="text" id="c-wa" class="field-input"
              placeholder="cth: 08123456789 (wajib)" autocomplete="off" required />
          </div>
        </div>
      </div>

      <!-- Items Table Card -->
      <div class="inv-card items-card-wrap">
        <div class="items-table">
          <div class="items-thead">
            <span class="th th-name">ITEM KOMISI & DISKON</span>
            <span class="th th-harga">HARGA</span>
            <span class="th th-qty">QTY</span>
            <span class="th th-subtotal">SUBTOTAL</span>
            <span class="th th-aksi">AKSI</span>
          </div>
          <div class="items-body" id="items-body">
            <div class="empty-msg">
              <span class="empty-icon">🌸</span>
              <p>Belum ada item dipilih.</p>
              <p class="empty-sub">Klik produk di katalog kiri atau tambah item manual.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Discount Card (Precision POS Design) -->
      <div class="inv-card disc-card">
        <div class="disc-card-head">
          <div class="disc-head-title">
            <span class="disc-head-icon">⊘</span>
            <span>DISKON TAMBAHAN FAKTUR</span>
          </div>
          <span class="disc-head-badge" id="disc-head-badge">Tanpa Diskon</span>
        </div>

        <div class="disc-controls-grid">
          <!-- Segmented Type Selector -->
          <div class="disc-segmented-wrap" role="radiogroup" aria-label="Tipe Diskon">
            <label class="disc-segment-btn active" id="seg-btn-persen">
              <input type="radio" name="disc-t" value="persen" id="r-persen" checked />
              <span class="seg-label">Persen (%)</span>
            </label>
            <label class="disc-segment-btn" id="seg-btn-nominal">
              <input type="radio" name="disc-t" value="nominal" id="r-nominal" />
              <span class="seg-label" id="lbl-r-nominal">Flat / Nominal (Rp)</span>
            </label>
          </div>

          <!-- Precision Numeric Input -->
          <div class="disc-input-wrap">
            <input type="number" id="disc-val" class="disc-inp" value="0" min="0" step="any" placeholder="0" />
            <span class="disc-unit" id="disc-unit">%</span>
          </div>
        </div>
      </div>

      <!-- Totals Card -->
      <div class="totals-card">
        <div class="totals-sub-rows">
          <div class="tot-row">
            <span class="tot-lbl">Subtotal Kotor:</span>
            <span class="tot-val" id="t-subtotal">Rp 0</span>
          </div>
          <div class="tot-row hidden" id="t-disc-row">
            <span class="tot-lbl">Diskon:</span>
            <span class="tot-val disc-color" id="t-disc">- Rp 0</span>
          </div>
        </div>
        <div class="tot-final">
          <div class="tot-final-meta">
            <span class="tot-sparkle">✦</span>
            <span class="tot-lbl-main">TOTAL TAGIHAN:</span>
          </div>
          <span class="tot-val-main" id="t-total">Rp 0</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="inv-actions">
        <button class="act-btn wa-btn" id="btn-wa" type="button" title="Kirim rincian nota langsung ke WhatsApp Customer">
          <span class="act-icon">💬</span> Kirim ke WhatsApp
        </button>
        <button class="act-btn preview-btn" id="btn-preview" type="button" title="Shortcut: Alt+P">
          <span class="act-icon">🔍</span> Pratinjau Foto
        </button>
        <button class="act-btn download-btn" id="btn-download" type="button" title="Shortcut: Alt+D / Ctrl+Enter">
          <span class="act-icon">⬇</span> Unduh Foto Nota
        </button>
      </div>

      <!-- Bottom Decorative Spacer & Safe Area Buffer -->
      <div class="panel-bottom-spacer">
        <div class="spacer-divider">
          <span class="spacer-line"></span>
          <span class="spacer-icon">🌸</span>
          <span class="spacer-line"></span>
        </div>
        <div class="spacer-text">Amai Nota • Kwitansi Komisi Digital</div>
        <div class="spacer-sub">Tersimpan otomatis di kasir • Siap kirim</div>
      </div>

    </aside>
  </div>
</div>

<!-- ══ FLOATING TOAST NOTIFICATION ═══════════════ -->
<div class="floating-toast" id="floating-toast" aria-live="polite">
  <div class="toast-bubble">
    <div class="toast-icon-wrap">
      <span class="toast-icon" id="toast-icon">🌸</span>
    </div>
    <div class="toast-text-box">
      <div class="toast-title" id="toast-title">Pemberitahuan</div>
      <div class="toast-desc" id="toast-desc">Detail notifikasi</div>
    </div>
    <button class="toast-close" id="toast-close" type="button" aria-label="Tutup notifikasi">✕</button>
  </div>
</div>

<!-- ══ RECEIPT MODAL ══════════════════════════════ -->
<div class="r-modal hidden" id="r-modal">
  <div class="r-backdrop" id="r-backdrop"></div>
  <div class="r-container">
    <div id="r-render"></div>
    <div class="r-modal-btns">
      <button class="r-close-btn" id="r-close" type="button">✕ Tutup</button>
      <button class="r-wa-btn" id="r-wa" type="button">💬 Kirim WhatsApp</button>
      <button class="r-dl-btn" id="r-dl" type="button">⬇ Unduh Foto Nota</button>
    </div>
  </div>
</div>



</Layout>

<script is:inline>
(function () {

  /* ── PRODUCTS (IDR & USD) ───────────────────────── */
  var PRODUCTS = [
    { id:'bust-up',     name:'Bust Up',                        priceIDR:80000,  priceUSD:25,  cat:'ilustrasi', badge:null,          approx:false },
    { id:'avatar-icon', name:'Genshin Avatar Icon',            priceIDR:100000, priceUSD:30,  cat:'ilustrasi', badge:null,          approx:false },
    { id:'half-body',   name:'Half Body',                      priceIDR:150000, priceUSD:40,  cat:'ilustrasi', badge:null,          approx:false },
    { id:'full-body',   name:'Full Body',                      priceIDR:200000, priceUSD:60,  cat:'ilustrasi', badge:null,          approx:false },
    { id:'drip',        name:'Genshin Drip Marketing',         priceIDR:260000, priceUSD:70,  cat:'ilustrasi', badge:null,          approx:false },
    { id:'cs-simple',   name:'Character Sheet (Simple)',       priceIDR:250000, priceUSD:85,  cat:'charsheet', badge:'CS Simple',   approx:true  },
    { id:'cs-over',     name:'Character Sheet (Overdetailed)', priceIDR:500000, priceUSD:140, cat:'charsheet', badge:'CS Over',     approx:true, displayPriceUSD:'$140–$150~' },
    { id:'addon-bg',    name:'Background',                     priceIDR:50000,  priceUSD:8,   cat:'addon',     badge:null,          approx:false },
    { id:'addon-rush1', name:'Rush Fee (1 hari kerja)',        priceIDR:50000,  priceUSD:8,   cat:'addon',     badge:'Rush',        approx:false },
    { id:'addon-rush2', name:'Rush Fee (2 hari kerja)',        priceIDR:25000,  priceUSD:5,   cat:'addon',     badge:'Rush',        approx:false },
    { id:'addon-rush3', name:'Rush Fee (3 hari kerja)',        priceIDR:10000,  priceUSD:2,   cat:'addon',     badge:'Rush',        approx:false },
    { id:'addon-rev',   name:'Revisi Ekstra',                  priceIDR:10000,  priceUSD:2,   cat:'addon',     badge:null,          approx:false },
    { id:'addon-bgs',   name:'BG + Detail (Simple)',           priceIDR:30000,  priceUSD:5,   cat:'addon',     badge:'BG+',         approx:false },
    { id:'addon-bgm',   name:'BG + Detail (Medium)',           priceIDR:100000, priceUSD:15,  cat:'addon',     badge:'BG+',         approx:false },
    { id:'addon-bgf',   name:'BG + Detail (Full)',             priceIDR:200000, priceUSD:25,  cat:'addon',     badge:'BG+',         approx:false },
    { id:'addon-couple',name:'Couple (2× base price)',          priceIDR:0,      priceUSD:0,   cat:'addon',     badge:'Couple',      approx:true  },
    { id:'addon-comm',  name:'Commercial Use (2× base)',       priceIDR:0,      priceUSD:0,   cat:'addon',     badge:'Commercial',  approx:true  },
    { id:'addon-custom',name:'Item Lainnya / Custom',          priceIDR:0,      priceUSD:0,   cat:'addon',     badge:'Bebas Isi',   approx:false, isCustom:true },
  ];

  var BADGE_STYLE = {
    'CS Simple':  'background:rgba(180,135,40,0.12);color:#966914;border:1px solid rgba(180,135,40,0.35)',
    'CS Over':    'background:rgba(150,105,30,0.14);color:#7d5208;border:1px solid rgba(150,105,30,0.4)',
    'Rush':       'background:rgba(215,115,25,0.12);color:#b35f0e;border:1px solid rgba(215,115,25,0.35)',
    'BG+':        'background:rgba(25,145,130,0.12);color:#147a70;border:1px solid rgba(25,145,130,0.35)',
    'Couple':     'background:rgba(205,90,130,0.12);color:#aa3966;border:1px solid rgba(205,90,130,0.35)',
    'Commercial': 'background:rgba(201,151,42,0.15);color:#946a10;border:1px solid rgba(201,151,42,0.4)',
    'Bebas Isi':   'background:rgba(201,151,42,0.18);color:#8d650e;border:1px solid rgba(201,151,42,0.45)',
  };

  /* ── STATE ─────────────────────────────────────── */
  var state = { cart:[], status:'belum', activeCat:'all', search:'', discType:'persen', discVal:0, currency:'IDR' };

  /* ── UTILS ─────────────────────────────────────── */
  function getProductPrice(p){
    return state.currency === 'USD' ? p.priceUSD : p.priceIDR;
  }
  function currSymbol(){
    return state.currency === 'USD' ? '$' : 'Rp';
  }
  function fmt(n){
    if(state.currency === 'USD'){
      return '$' + Number(n).toLocaleString('en-US');
    }
    return 'Rp ' + Number(n).toLocaleString('id-ID');
  }
  function uid(){ return '_'+Math.random().toString(36).substr(2,9); }
  function getToday(){ return new Date().toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}); }
  function el(id){ return document.getElementById(id); }

  /* ── FLOATING TOAST NOTIFICATION ───────────────── */
  var toastTimer = null;
  function showToast(title, desc, icon){
    var toast = el('floating-toast');
    if(!toast) return;
    var ti = el('toast-icon');
    var tt = el('toast-title');
    var td = el('toast-desc');
    if(ti) ti.textContent = icon || '🌸';
    if(tt) tt.textContent = title || 'Pemberitahuan';
    if(td){
      if(desc){
        td.textContent = desc;
        td.style.display = 'block';
      } else {
        td.style.display = 'none';
      }
    }
    toast.classList.add('show');
    if(toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){
      toast.classList.remove('show');
    }, 2800);
  }

  /* ── DATE ──────────────────────────────────────── */
  function renderDate(){
    var d=getToday();
    var h=el('hdr-date'); if(h) h.textContent=d;
    var i=el('inv-date'); if(i) i.textContent='📅 '+d;
  }

  /* ── PRODUCTS ──────────────────────────────────── */
  function getFiltered(){
    return PRODUCTS.filter(function(p){
      var catMatch = (state.activeCat==='all' || p.cat===state.activeCat || p.isCustom);
      var searchMatch = (!state.search || p.name.toLowerCase().includes(state.search.toLowerCase()) || (p.isCustom && 'custom lainnya manual bebas tambahan opsi'.indexOf(state.search.toLowerCase()) !== -1));
      return catMatch && searchMatch;
    });
  }

  function renderProducts(){
    var grid=el('product-grid'); if(!grid) return;
    var list=getFiltered();
    if(!list.length){
      grid.innerHTML='<div class="no-results"><span class="no-results-icon">🌸</span><p>Tidak ada paket yang cocok.</p><p class="no-results-sub">Gunakan pencarian lain atau tambah item manual di atas.</p></div>';
      return;
    }
    var sym = currSymbol();
    grid.innerHTML=list.map(function(p){
      var badge=p.badge?'<span class="prod-badge" style="'+(BADGE_STYLE[p.badge]||'')+'">'+p.badge+'</span>':'';
      var price = getProductPrice(p);
      
      /* Card khusus: Item Lainnya / Custom (Nama & Harga diisi sendiri langsung di card) */
      if(p.isCustom){
        var placeholderVal = state.currency === 'USD' ? 'cth: 25' : 'cth: 50000';
        return '<div class="prod-card prod-card-custom prod-card-full-custom" data-id="'+p.id+'">'
          +'<div class="prod-card-top">'
          +'  <div class="prod-name">✨ '+p.name+'</div>'
          +   badge
          +'</div>'
          +'<div class="prod-divider"></div>'
          +'<div class="card-inline-box">'
          +'  <div class="card-inline-lbl">Nama Item:</div>'
          +'  <input type="text" class="card-inline-name-inp" data-id="'+p.id+'" placeholder="cth: Weapon / Emote / Live2D" autocomplete="off" />'
          +'  <div class="card-inline-lbl" style="margin-top:2px;">Nominal ('+sym+'):</div>'
          +'  <div class="card-inline-input-wrap">'
          +'    <span class="card-inline-curr">'+sym+'</span>'
          +'    <input type="number" class="card-inline-inp" data-id="'+p.id+'" placeholder="'+placeholderVal+'" min="0" autocomplete="off" />'
          +'  </div>'
          +'  <button class="btn-pilih btn-inline-add-custom" data-id="'+p.id+'" type="button">+ Tambah</button>'
          +'</div>'
          +'</div>';
      }

      /* Card khusus: input nominal harga langsung di kartu (contoh: Couple, Commercial Use) */
      if(price === 0){
        var placeholderVal = state.currency === 'USD' ? 'cth: 50' : 'cth: 150000';
        return '<div class="prod-card prod-card-custom" data-id="'+p.id+'">'
          +'<div class="prod-card-top">'
          +'  <div class="prod-name">'+p.name+'</div>'
          +   badge
          +'</div>'
          +'<div class="prod-divider"></div>'
          +'<div class="card-inline-box">'
          +'  <div class="card-inline-lbl">Isi Nominal ('+sym+'):</div>'
          +'  <div class="card-inline-input-wrap">'
          +'    <span class="card-inline-curr">'+sym+'</span>'
          +'    <input type="number" class="card-inline-inp" data-id="'+p.id+'" placeholder="'+placeholderVal+'" min="0" autocomplete="off" />'
          +'  </div>'
          +'  <button class="btn-pilih btn-inline-add" data-id="'+p.id+'" type="button">+ Tambah</button>'
          +'</div>'
          +'</div>';
      }

      var priceText = (state.currency === 'USD' && p.displayPriceUSD)
        ? p.displayPriceUSD
        : (fmt(price) + (p.approx ? '<span class="approx">~</span>' : ''));
      var priceHtml='<span class="prod-price">'+priceText+'</span>';
      return '<div class="prod-card" data-id="'+p.id+'">'
        +'<div class="prod-card-top">'
        +'  <div class="prod-name">'+p.name+(p.approx?'<span class="approx">~</span>':'')+'</div>'
        +   badge
        +'</div>'
        +'<div class="prod-divider"></div>'
        +'<div class="prod-bottom">'
        +'  '+priceHtml
        +'  <button class="btn-pilih" data-id="'+p.id+'" type="button">+ Pilih</button>'
        +'</div>'
        +'</div>';
    }).join('');

    /* Custom full card events: Name + Price */
    grid.querySelectorAll('.card-inline-name-inp').forEach(function(inp){
      inp.addEventListener('click', function(e){ e.stopPropagation(); });
      inp.addEventListener('keydown', function(e){
        if(e.key==='Enter'){
          var card = inp.closest('.prod-card-full-custom');
          var priceInp = card ? card.querySelector('.card-inline-inp') : null;
          if(priceInp) priceInp.focus();
        }
      });
    });

    grid.querySelectorAll('.btn-inline-add-custom').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        var card = btn.closest('.prod-card-full-custom');
        if(!card) return;
        var nameInp = card.querySelector('.card-inline-name-inp');
        var priceInp = card.querySelector('.card-inline-inp');
        var nameVal = nameInp ? nameInp.value.trim() : '';
        var priceVal = parseInt(priceInp ? priceInp.value : 0);

        if(!nameVal){
          if(nameInp) nameInp.focus();
          showToast('Isi Nama Item', 'Tuliskan nama item yang ingin ditambahkan', '⚠️');
          return;
        }
        if(!priceVal || priceVal <= 0){
          if(priceInp) priceInp.focus();
          showToast('Isi Nominal Harga', 'Tuliskan nominal harga ('+currSymbol()+') untuk ' + nameVal, '⚠️');
          return;
        }

        state.cart.push({
          uid: uid(),
          id: 'custom-' + uid(),
          name: nameVal,
          price: priceVal,
          qty: 1,
          approx: false,
          isCustomPrice: true
        });

        showToast('Ditambahkan ke Nota', nameVal + ' • ' + fmt(priceVal), '🌸');

        if(nameInp) nameInp.value = '';
        if(priceInp) priceInp.value = '';

        btn.textContent = '✓ Ditambah!';
        btn.classList.add('added');
        setTimeout(function(){
          btn.textContent = '+ Tambah';
          btn.classList.remove('added');
        }, 1000);

        renderCart();
        updateTotals();
      });
    });

    /* Custom inline price-only input events */
    grid.querySelectorAll('.card-inline-inp').forEach(function(inp){
      inp.addEventListener('click', function(e){ e.stopPropagation(); });
      inp.addEventListener('keydown', function(e){
        if(e.key==='Enter'){
          var customBtn = inp.closest('.prod-card-full-custom') ? inp.closest('.prod-card-full-custom').querySelector('.btn-inline-add-custom') : null;
          if(customBtn){
            customBtn.click();
            return;
          }
          var btn = grid.querySelector('.btn-inline-add[data-id="'+inp.dataset.id+'"]');
          if(btn) btn.click();
        }
      });
    });

    grid.querySelectorAll('.btn-inline-add').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        var p = PRODUCTS.find(function(x){ return x.id === btn.dataset.id; });
        if(!p) return;
        var card = btn.closest('.prod-card');
        var inp = card ? card.querySelector('.card-inline-inp') : null;
        var val = parseInt(inp ? inp.value : 0);
        if(!val || val <= 0){
          if(inp) inp.focus();
          showToast('Isi Nominal Harga', 'Tuliskan harga ('+currSymbol()+') untuk ' + p.name, '⚠️');
          return;
        }
        state.cart.push({uid:uid(), id:p.id, name:p.name, price:val, qty:1, approx:true, isCustomPrice:true});
        showToast('Ditambahkan ke Nota', p.name + ' • ' + fmt(val), '🌸');
        btn.textContent = '✓ Ditambah!';
        btn.classList.add('added');
        setTimeout(function(){
          btn.textContent = '+ Tambah';
          btn.classList.remove('added');
        }, 1000);
        renderCart();
        updateTotals();
      });
    });

    /* Regular card events */
    grid.querySelectorAll('.prod-card:not(.prod-card-custom)').forEach(function(card){
      card.addEventListener('click', function(){
        var p = PRODUCTS.find(function(x){ return x.id === card.dataset.id; });
        if(p) addToCart(p);
      });
    });

    grid.querySelectorAll('.btn-pilih:not(.btn-inline-add):not(.btn-inline-add-custom)').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        var p = PRODUCTS.find(function(x){ return x.id === btn.dataset.id; });
        if(p) addToCart(p);
      });
    });
  }

  /* ── CART ──────────────────────────────────────── */
  function addToCart(p){
    var price = getProductPrice(p);
    var ex=state.cart.find(function(i){return i.id===p.id;});
    if(ex){ ex.qty++; }
    else { state.cart.push({uid:uid(),id:p.id,name:p.name,price:price,qty:1,approx:p.approx,isCustomPrice:false}); }

    showToast('Ditambahkan ke Nota', p.name + ' • ' + fmt(price) + (p.approx?'~':''), '🌸');

    var btn=document.querySelector('.btn-pilih[data-id="'+p.id+'"]');
    if(btn){
      btn.textContent='✓ Ditambah!';
      btn.classList.add('added');
      setTimeout(function(){
        btn.textContent='+ Pilih';
        btn.classList.remove('added');
      },1000);
    }
    renderCart();
    updateTotals();
  }

  function removeItem(u){
    var item=state.cart.find(function(i){return i.uid===u;});
    if(item) showToast('Item Dihapus', item.name + ' dikeluarkan dari nota', '🗑️');
    state.cart=state.cart.filter(function(i){return i.uid!==u;});
    renderCart();
    updateTotals();
  }

  function changeQty(u,d){
    var item=state.cart.find(function(i){return i.uid===u;});
    if(item){
      item.qty=Math.max(1,item.qty+d);
      showToast('Jumlah Diubah', item.name + ' (' + item.qty + '×)', '🔢');
      renderCart();
      updateTotals();
    }
  }

  function renderCart(){
    var body=el('items-body'); if(!body) return;
    if(!state.cart.length){
      body.innerHTML='<div class="empty-msg"><span class="empty-icon">🌸</span><p>Belum ada item dipilih.</p><p class="empty-sub">Klik produk di katalog kiri atau tambah item manual.</p></div>';
      return;
    }
    body.innerHTML=state.cart.map(function(item){
      return '<div class="item-row">'
        +'<div class="item-name">'+item.name+(item.approx?'<span class="approx">~</span>':'')+'</div>'
        +'<div class="item-price">'+fmt(item.price)+'</div>'
        +'<div class="item-qty">'
        +'  <button class="qty-btn" data-uid="'+item.uid+'" data-delta="-1" type="button">−</button>'
        +'  <span class="qty-num">'+item.qty+'</span>'
        +'  <button class="qty-btn" data-uid="'+item.uid+'" data-delta="1" type="button">+</button>'
        +'</div>'
        +'<div class="item-sub">'+fmt(item.price*item.qty)+'</div>'
        +'<button class="item-del" data-uid="'+item.uid+'" title="Hapus item" type="button">×</button>'
        +'</div>';
    }).join('');

    body.querySelectorAll('.qty-btn').forEach(function(b){
      b.addEventListener('click',function(){ changeQty(b.dataset.uid,parseInt(b.dataset.delta)); });
    });
    body.querySelectorAll('.item-del').forEach(function(b){
      b.addEventListener('click',function(){ removeItem(b.dataset.uid); });
    });
  }

  /* ── TOTALS ────────────────────────────────────── */
  function calcTotals(){
    var sub=state.cart.reduce(function(s,i){return s+i.price*i.qty;},0);
    var disc=0;
    if(state.discVal>0){
      disc=state.discType==='persen'?Math.round(sub*state.discVal/100):Math.min(state.discVal,sub);
    }
    return {subtotal:sub,discount:disc,total:Math.max(0,sub-disc)};
  }

  function updateTotals(){
    var r=calcTotals();
    var es=el('t-subtotal'); if(es) es.textContent=fmt(r.subtotal);
    var et=el('t-total');    if(et) et.textContent=fmt(r.total);
    var dr=el('t-disc-row'); var ed=el('t-disc');
    if(r.discount>0){
      dr&&dr.classList.remove('hidden');
      if(ed) ed.textContent='- '+fmt(r.discount);
    } else {
      dr&&dr.classList.add('hidden');
    }

    var badge=el('disc-head-badge');
    if(badge){
      if(r.discount>0){
        badge.textContent = state.discType==='persen' ? ('-' + state.discVal + '% (' + fmt(r.discount) + ')') : ('- ' + fmt(r.discount));
        badge.classList.add('active');
      } else {
        badge.textContent = 'Tanpa Diskon';
        badge.classList.remove('active');
      }
    }
  }

  function updateDiscPillClasses(){
    var sp=el('seg-btn-persen');
    var sn=el('seg-btn-nominal');
    if(sp) sp.classList.toggle('active', state.discType === 'persen');
    if(sn) sn.classList.toggle('active', state.discType === 'nominal');
  }

  /* ── VALIDATION ────────────────────────────────── */
  function validateCustomer(shouldFocus){
    var nameEl = el('c-name');
    var waEl = el('c-wa');
    var nameVal = nameEl ? nameEl.value.trim() : '';
    var waVal = waEl ? waEl.value.trim() : '';

    if(nameEl) nameEl.classList.remove('input-error');
    if(waEl) waEl.classList.remove('input-error');

    if(!nameVal){
      if(nameEl){
        nameEl.classList.add('input-error');
        if(shouldFocus) nameEl.focus();
      }
      showToast('Nama Customer Wajib Diisi', 'Silakan tulis nama customer pada kolom rincian nota', '⚠️');
      return false;
    }

    if(!waVal){
      if(waEl){
        waEl.classList.add('input-error');
        if(shouldFocus) waEl.focus();
      }
      showToast('No. WhatsApp Wajib Diisi', 'Silakan isi nomor WhatsApp customer untuk verifikasi nota', '⚠️');
      return false;
    }

    if(!state.cart.length){
      showToast('Pilih Paket Komisi', 'Tambahkan minimal satu paket komisi ke nota', '⚠️');
      return false;
    }

    return true;
  }

  /* ── WHATSAPP SENDER ───────────────────────────── */
  function sendWhatsApp(){
    if(!validateCustomer(true)) return;

    var cName = el('c-name').value.trim();
    var cWa   = el('c-wa').value.trim();
    var r = calcTotals();
    var isLunas = state.status === 'lunas';
    var statusText = isLunas ? 'SUDAH LUNAS ✅' : 'BELUM BAYAR ⏳';
    var currTag = state.currency === 'USD' ? ' [USD / Internasional]' : ' [IDR]';

    var phone = cWa.replace(/[^0-9]/g, '');
    if(phone.startsWith('08')){
      phone = '628' + phone.substring(2);
    } else if(phone.startsWith('8')){
      phone = '628' + phone.substring(1);
    }

    if(phone.length < 8){
      if(el('c-wa')){
        el('c-wa').classList.add('input-error');
        el('c-wa').focus();
      }
      showToast('Nomor WhatsApp Kurang', 'Pastikan nomor WhatsApp ditulis lengkap (cth: 0812...)', '⚠️');
      return;
    }

    var itemsText = state.cart.map(function(item, idx){
      return (idx + 1) + '. *' + item.name + (item.approx ? '~' : '') + '* (' + item.qty + '×) : ' + fmt(item.price * item.qty);
    }).join('\n');

    var discText = r.discount > 0 ? ('\nDiskon Faktur: -' + fmt(r.discount)) : '';

    var msg = 'Halo kak *' + cName + '*! 🌸\n'
      + 'Berikut adalah rincian nota kwitansi komisi dari *Amai Nota*' + currTag + ':\n\n'
      + '📅 *Tanggal:* ' + getToday() + '\n'
      + '👤 *Customer:* ' + cName + '\n'
      + '📱 *Kontak:* ' + cWa + '\n'
      + '📌 *Status Transaksi:* ' + statusText + '\n\n'
      + '━━━━━━━━━━━━━━━━━━━\n'
      + '📝 *RINCIAN PAKET KOMISI:*\n'
      + itemsText + '\n'
      + '━━━━━━━━━━━━━━━━━━━\n'
      + 'Subtotal: ' + fmt(r.subtotal) + discText + '\n'
      + '💰 *TOTAL TAGIHAN: ' + fmt(r.total) + '*\n'
      + '━━━━━━━━━━━━━━━━━━━\n\n'
      + '✦ Terima kasih atas kerjasamanya! 🌸\n'
      + 'Konfirmasi detail & pembayaran via chat ini ya kak ✨';

    var url = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(msg);
    window.open(url, '_blank');
    showToast('Membuka WhatsApp', 'Mengalihkan pesan nota ke ' + cName, '💬');
  }

  /* ── CURRENCY SWITCHER ─────────────────────────── */
  function switchCurrency(curr){
    if(state.currency === curr) return;
    state.currency = curr;

    var bIdr = el('curr-btn-idr');
    var bUsd = el('curr-btn-usd');
    if(bIdr) bIdr.classList.toggle('active', curr === 'IDR');
    if(bUsd) bUsd.classList.toggle('active', curr === 'USD');

    // Update prices of standard items in the cart
    state.cart.forEach(function(item){
      var prod = PRODUCTS.find(function(p){ return p.id === item.id; });
      if(prod && !item.isCustomPrice && getProductPrice(prod) > 0){
        item.price = (curr === 'USD' ? prod.priceUSD : prod.priceIDR);
      }
    });

    // Update manual item label & placeholder
    var mc = el('m-currency');
    if(mc) mc.textContent = currSymbol();
    var mp = el('m-price');
    if(mp) mp.placeholder = 'Harga nominal (' + currSymbol() + ')...';

    // Update discount nominal label & unit
    var lr = el('lbl-r-nominal');
    if(lr) lr.textContent = 'Flat / Nominal (' + currSymbol() + ')';
    var du = el('disc-unit');
    if(du && state.discType === 'nominal') du.textContent = currSymbol();

    // Reset flat nominal discount when switching currency so IDR amount doesn't break USD totals
    if(state.discType === 'nominal' && state.discVal > 0){
      state.discVal = 0;
      var dv = el('disc-val');
      if(dv) dv.value = '0';
    }

    renderProducts();
    renderCart();
    updateTotals();

    showToast(
      curr === 'USD' ? 'Mata Uang: USD ($)' : 'Mata Uang: IDR (Rp)',
      curr === 'USD' ? 'Katalog beralih ke harga Internasional / Luar Negeri' : 'Katalog beralih ke harga Rupiah Indonesia',
      curr === 'USD' ? '🌍' : '🇮🇩'
    );
  }

